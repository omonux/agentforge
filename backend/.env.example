DATABASE_PATH=./agentforge.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Required once for encrypted Connect API credentials. Generate with the command below.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Required private-workspace security settings. Replace placeholders before starting.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Generate once with: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_PASSWORD_SALT=REPLACE_WITH_A_RANDOM_SALT_AT_LEAST_16_CHARACTERS
# Set true for HTTPS hosting. Set false only for local http://localhost development.
COOKIE_SECURE=false

# Billing: NGN plan prices are whole naira; never commit live merchant credentials.
BILLING_BASE_URL=https://your-public-agentforge-domain.example
BILLING_ENABLED=false
BILLING_LIVE_ENABLED=false
AGENTFORGE_PRO_MONTHLY_NGN=
AGENTFORGE_BUSINESS_MONTHLY_NGN=
PAYSTACK_SECRET_KEY=
# Optional Paystack plan codes enable recurring card subscriptions.
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_BUSINESS_MONTHLY_PLAN_CODE=

# OPay hosted cashier (Nigeria). Confirm the exact API base URL and card method
# are enabled for your approved merchant account before enabling live billing.
OPAY_API_BASE_URL=https://sandboxapi.opaycheckout.com
OPAY_COUNTRY=NG
OPAY_CURRENCY=NGN
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=

# Image generation (configure on the backend only; never put keys in frontend variables)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_STORAGE_DIR=./storage/generated_images
IMAGE_MAX_UPLOAD_BYTES=12000000

# YouTube OAuth (Google Cloud Console OAuth Web client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
YOUTUBE_REGION=NG

# Optional voice generation (managed in the Connect API page)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Video generation provider (Replicate model slug owner/model)
VIDEO_PROVIDER=replicate
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_INPUT_JSON={"aspect_ratio":"9:16","duration":30}
YOUTUBE_STORAGE_DIR=./storage/youtube

# REAL-MONEY SPOT EXECUTION. Keep disabled until live keys are stored in the encrypted Integrations vault.
# Keys must have Spot trading only, withdrawals disabled, and IP restrictions where supported.
LIVE_TRADING_ENABLED=false
BYBIT_LIVE_TRADING_ENABLED=false
LIVE_MAX_ORDER_NOTIONAL_USDT=25
LIVE_MAX_DAILY_NOTIONAL_USDT=100
